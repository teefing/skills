{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bytedcli.local/schemas/ftf-remediation-execution-plan.json",
  "title": "FTF Remediation Execution Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_plan_id",
    "source_plan_hash",
    "source_evidence_hash",
    "task_snapshot",
    "selected_action_ids",
    "items",
    "preflight_snapshot",
    "invalidation_rules",
    "execution_hash"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "source_plan_id": { "type": "string", "minLength": 1 },
    "source_plan_hash": { "$ref": "#/$defs/hash" },
    "source_evidence_hash": { "$ref": "#/$defs/hash" },
    "task_snapshot": { "$ref": "#/$defs/taskSnapshot" },
    "selected_action_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    },
    "preflight_snapshot": { "$ref": "#/$defs/preflightSnapshot" },
    "invalidation_rules": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "execution_hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "taskSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "site", "space_id", "update_time", "snapshot_hash"],
      "properties": {
        "id": { "type": "integer", "minimum": 0 },
        "site": { "const": "cn" },
        "space_id": { "type": ["string", "null"] },
        "update_time": { "type": ["string", "null"] },
        "snapshot_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "psm",
        "method",
        "direction",
        "outbound_psm",
        "outbound_method",
        "diff_path"
      ],
      "properties": {
        "psm": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["inbound", "outbound"] },
        "outbound_psm": { "type": ["string", "null"] },
        "outbound_method": { "type": ["string", "null"] },
        "diff_path": { "type": "string", "minLength": 1 }
      }
    },
    "arrayParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_name", "mode", "match_type", "key_list"],
      "properties": {
        "scene_name": { "type": "string", "minLength": 1 },
        "mode": { "enum": [1, 2] },
        "match_type": { "enum": [2, 3] },
        "key_list": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "match_type": { "const": 2 } } },
          "then": { "properties": { "key_list": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "match_type": { "const": 3 } } },
          "then": { "properties": { "key_list": { "minItems": 1 } } }
        }
      ]
    },
    "noiseTemplateParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "timeOffsetParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset_seconds"],
      "properties": {
        "offset_seconds": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "finding_id",
        "cluster_id",
        "psm_task_id",
        "similar_diff_id",
        "operation",
        "target",
        "parameters",
        "expected_change",
        "read_back",
        "rollback"
      ],
      "properties": {
        "action_id": { "type": "string", "minLength": 1 },
        "finding_id": { "type": "string", "minLength": 1 },
        "cluster_id": { "type": "string", "minLength": 1 },
        "psm_task_id": { "type": "integer", "minimum": 0 },
        "similar_diff_id": { "type": "string", "minLength": 1 },
        "operation": {
          "enum": ["add_noise_template", "set_time_offset", "update_array_match"]
        },
        "target": { "$ref": "#/$defs/target" },
        "parameters": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/noiseTemplateParameters" },
            { "$ref": "#/$defs/timeOffsetParameters" },
            { "$ref": "#/$defs/arrayParameters" }
          ]
        },
        "expected_change": { "type": "string", "minLength": 1 },
        "read_back": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selector", "expected_operation"],
          "properties": {
            "selector": { "$ref": "#/$defs/target" },
            "expected_operation": {
              "enum": ["add_noise_template", "set_time_offset", "update_array_match"]
            }
          }
        },
        "rollback": { "type": "string", "minLength": 1 }
      }
    },
    "preflightDiff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "finding_id",
        "cluster_id",
        "similar_diff_id",
        "operation",
        "status",
        "process_mode",
        "executed",
        "target"
      ],
      "properties": {
        "action_id": { "type": "string", "minLength": 1 },
        "finding_id": { "type": "string", "minLength": 1 },
        "cluster_id": { "type": "string", "minLength": 1 },
        "similar_diff_id": { "type": "string", "minLength": 1 },
        "operation": {
          "enum": ["add_noise_template", "set_time_offset", "update_array_match"]
        },
        "status": { "const": "passed" },
        "process_mode": { "const": "dry_run" },
        "executed": { "const": false },
        "expected_config_version": { "type": "string", "minLength": 1 },
        "expected_config_target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["psm", "method", "direction", "scene_name", "mode", "path"],
          "properties": {
            "psm": { "type": "string", "minLength": 1 },
            "method": { "type": "string", "minLength": 1 },
            "direction": { "enum": ["inbound", "outbound"] },
            "scene_name": { "type": "string", "minLength": 1 },
            "mode": { "type": "integer" },
            "path": { "type": "string", "minLength": 1 }
          }
        },
        "target": { "$ref": "#/$defs/target" }
      }
    },
    "parentConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "finding_id",
        "schema_id",
        "parent_mode",
        "config_last_modify_time",
        "exact_path",
        "exact_path_state"
      ],
      "properties": {
        "action_id": { "type": "string", "minLength": 1 },
        "finding_id": { "type": "string", "minLength": 1 },
        "schema_id": { "type": "string", "minLength": 1 },
        "parent_mode": { "enum": ["system", "sandbox"] },
        "config_last_modify_time": { "type": "string", "minLength": 1 },
        "exact_path": { "type": "string", "minLength": 1 },
        "exact_path_state": {}
      }
    },
    "preflightSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "diffs", "parent_configs"],
      "properties": {
        "task": { "$ref": "#/$defs/taskSnapshot" },
        "diffs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/preflightDiff" }
        },
        "parent_configs": {
          "type": "array",
          "items": { "$ref": "#/$defs/parentConfig" }
        }
      }
    }
  }
}
